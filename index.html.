
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>секрет</title>
  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      overflow: hidden;
      font-family: Georgia, "Times New Roman", serif;
      color: #742d3b;
      background:
        radial-gradient(circle at 15% 20%, rgba(255,255,255,.9), transparent 30%),
        radial-gradient(circle at 85% 80%, rgba(255,220,225,.9), transparent 35%),
        #fff4f2;
    }

    .card {
      width: min(90vw, 520px);
      min-height: 420px;
      padding: 42px 24px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: rgba(255,255,255,.72);
      border: 1px solid rgba(177,75,94,.16);
      border-radius: 28px;
      box-shadow: 0 18px 55px rgba(126,54,69,.12);
      position: relative;
    }

    .heart {
      font-size: 52px;
      margin-bottom: 12px;
    }

    h1 {
      font-size: clamp(28px, 7vw, 40px);
      margin: 0 0 12px;
    }

    p {
      font: 15px/1.5 Arial, sans-serif;
      color: #a16a73;
      margin: 0 0 30px;
    }

    .buttons {
      width: min(100%, 310px);
      height: 58px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      position: relative;
    }

    button {
      border: 0;
      border-radius: 999px;
      padding: 13px 30px;
      min-width: 112px;
      font: bold 16px Arial, sans-serif;
      cursor: pointer;
      transition: background .2s, transform .2s;
    }

    #yes {
      color: white;
      background: #b7435b;
      box-shadow: 0 7px 18px #b7435b35;
    }

    #yes:hover {
      background: #9e3049;
      transform: translateY(-2px);
    }

    #no {
      color: #8d5360;
      background: #f5dfe2;
      position: relative;
      touch-action: none;
    }

    .hidden {
      display: none;
    }

    #message {
      margin-top: 25px;
      font: 18px/1.6 Arial, sans-serif;
      color: #963d52;
    }

    .tiny {
      position: absolute;
      bottom: 17px;
      font: 11px Arial, sans-serif;
      color: #c08c94;
    }
  </style>
</head>

<body>
  <main class="card">
    <div class="heart">♡</div>

    <h1>Мы вместе навечно?</h1>

    <p>У меня есть для тебя один очень важный вопрос...</p>

    <div class="buttons" id="buttonArea">
      <button id="yes">Да ❤️</button>
      <button id="no">Нет</button>
    </div>

    <div id="message" class="hidden">
      Я так и знала ❤️<br>
      Ты очень дорог мне, Егор
    </div>

    <div class="tiny">сделано с любовью</div>
  </main>

  <script>
    const noButton = document.getElementById('no');
    const area = document.getElementById('buttonArea');
    const yesButton = document.getElementById('yes');
    const message = document.getElementById('message');

    function moveNoButton() {
      const areaRect = area.getBoundingClientRect();
      const maxX = Math.max(0, areaRect.width - noButton.offsetWidth);
      const maxY = 90;

      const x = Math.random() * maxX - maxX / 2;
      const y = (Math.random() - 0.5) * maxY;

      noButton.style.position = 'absolute';
      noButton.style.left = `calc(50% + ${x}px)`;
      noButton.style.top = `calc(50% + ${y}px)`;
      noButton.style.transform = 'translate(-50%, -50%)';
    }

    noButton.addEventListener('pointerenter', moveNoButton);

    noButton.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      moveNoButton();
    });

    noButton.addEventListener('click', (event) => {
      event.preventDefault();
      moveNoButton();
    });

    yesButton.addEventListener('click', () => {
      message.classList.remove('hidden');

      document.querySelector('h1').textContent = 'Урааа! ❤️';
      document.querySelector('p').textContent =
        'Это мой самый любимый ответ';

      area.classList.add('hidden');
    });
  </script>
</body>
</html>
